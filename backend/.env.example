# ─── LegalAI Backend — Environment Configuration ────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to GitHub!

# ── Google Gemini API ──────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ── LLM Provider ──────────────────────────────────────────────────────────
LLM_PROVIDER=gemini

# ── Database ───────────────────────────────────────────────────────────────
# Local SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///./legal_ai.db
# PostgreSQL (production — from docker-compose):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/legal_ai_db

# ── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ── Redis (optional — only needed for Celery task queue) ───────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB (optional — semantic vector search) ───────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=indian_legal_corpus

# ── File Upload ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── Optional: Indian Kanoon API (for live case law search) ─────────────────
# INDIAN_KANOON_API_KEY=your_indian_kanoon_api_key_here
